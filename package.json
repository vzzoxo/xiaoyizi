{
  "name": "vless-panel",
  "version": "4.1.1",
  "description": "",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "pm2": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop vless-panel",
    "pm2:restart": "pm2 restart vless-panel",
    "pm2:logs": "pm2 logs vless-panel",
    "test": "node --require ./test/setup.cjs --test --test-timeout=30000 test/*.test.js",
    "build:css": "npx tailwindcss -o public/css/tailwind.min.css --minify",
    "build:worker": "node scripts/build-worker.mjs",
    "dev": "npm run build:worker && wrangler dev",
    "deploy": "npm run build:worker && wrangler deploy",
    "check:worker": "npm run build:worker && wrangler deploy --dry-run",
    "test:worker": "npm run build:worker && node scripts/smoke-worker.mjs",
    "build:ui": "node scripts/build-ui.mjs",
    "postinstall": "node scripts/build-ui.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@material/web": "^2.5.0",
    "better-sqlite3": "^12.6.2",
    "better-sqlite3-session-store": "^0.1.0",
    "dotenv": "^17.3.1",
    "ejs": "^4.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "express-session": "^1.19.0",
    "helmet": "^8.1.0",
    "morgan": "^1.10.1",
    "node-cron": "^4.2.1",
    "node-ssh": "^13.2.1",
    "node-telegram-bot-api": "^0.67.0",
    "nodemailer": "^7.0.13",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "socks-proxy-agent": "^8.0.5",
    "uuid": "^13.0.0",
    "ws": "^8.19.0",
    "esbuild": "^0.28.2"
  },
  "devDependencies": {
    "acorn": "^8.19.0",
    "eslint-scope": "^9.1.2",
    "miniflare": "5.20261104.0-beta",
    "tailwindcss": "^3.4.19",
    "wrangler": "^4.158.0"
  },
  "engines": {
    "node": ">=20"
  }
}
